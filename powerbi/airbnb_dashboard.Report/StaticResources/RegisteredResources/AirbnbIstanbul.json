{
  "name": "Airbnb Istanbul",
  "dataColors": [
    "#12937E",
    "#E4572E",
    "#5F5E5A",
    "#B4B2A9",
    "#D3D1C7",
    "#0B5C4F",
    "#5BBFAE",
    "#F2A58C"
  ],
  "background": "#FFFFFF",
  "foreground": "#2C2C2A",
  "tableAccent": "#12937E",
  "good": "#12937E",
  "neutral": "#B4B2A9",
  "bad": "#E4572E",
  "maximum": "#0B5C4F",
  "center": "#5BBFAE",
  "minimum": "#D4EFEA",
  "textClasses": {
    "callout": {
      "fontSize": 28,
      "fontFace": "Segoe UI",
      "color": "#2C2C2A"
    },
    "title": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#2C2C2A"
    },
    "header": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#2C2C2A"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#5F5E5A"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#D3D1C7"
              }
            },
            "radius": 6
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 12,
            "fontColor": {
              "solid": {
                "color": "#2C2C2A"
              }
            }
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ]
      }
    }
  }
}