table _Measures
	lineageTag: c8811883-2383-4c7c-b963-01fcad25a2a3

	measure 'Total Listings' = COUNTROWS(dim_listing)
		formatString: #,0
		lineageTag: c9d3c979-dce3-415b-9174-758943b8c57e

	measure 'Active Listings' = CALCULATE([Total Listings] , (dim_listing[is_active]) = TRUE())
		formatString: #,0
		lineageTag: ffc9664e-bf7b-4ca2-8453-4a81889effa3

	measure 'Active Listings Share' = DIVIDE ( [Active Listings],[Total Listings])
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: b33e1b25-3444-4a62-b9fa-ba16a1f64b51

	measure 'Total Hosts' = DISTINCTCOUNT( dim_listing[host_id])
		formatString: #,0
		lineageTag: 8d7e3294-8b85-4ce3-8ce1-c0474357bcfe

	measure 'Professional Host Share' = DIVIDE ( CALCULATE( [Total Listings], dim_listing[host_segment] = "Professional (5+ listings)"), [Total Listings])
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: aa68fc39-1fcc-494a-b141-d543f015ea9c

	measure 'Median Price' = CALCULATE(MEDIAN(dim_listing[price]), dim_listing[is_price_outlier] = FALSE (), dim_listing[is_long_min_stay] = FALSE())
		formatString: #,0
		lineageTag: 36c084d5-70c4-4770-be0c-791f84283230

	measure 'Professional Hosts Share Of Hosts' = DIVIDE(CALCULATE([Total Hosts],dim_listing[host_segment] = "Professional (5+ listings)"), [Total Hosts])
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 0b7236d6-7efb-477a-950f-505a4e3e0dbc

	measure 'Listing Share' = DIVIDE([Total Listings],CALCULATE([Total Listings],ALLSELECTED(dim_listing)))
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 4e7806bd-b345-4863-a68c-7f18ab01c3a7

	measure Reviews = COUNTROWS( fact_reviews )
		formatString: 0
		lineageTag: d83bf988-e0f5-40c8-8f0a-4c8268946e3a

	measure 'Reviews 2025' = CALCULATE([Reviews], dim_date[year_num] = 2025)
		formatString: 0
		lineageTag: c20f06b8-73fe-42e5-9046-259071fdf0fe

	measure 'Reviews Same Period 2025' = CALCULATE( [Reviews], DATESBETWEEN(dim_date[full_date],DATE (2025,1,1), DATE(2025,9,28)))
		formatString: #,0
		lineageTag: 3fca298c-d41c-4d9b-9f4e-4d5a2b010f46

	measure 'Reviews Same Period 2026' = CALCULATE( [Reviews], DATESBETWEEN(dim_date[full_date],DATE (2026,1,1), DATE(2026,9,28)))
		formatString: #,0
		lineageTag: f2bc3d62-677b-418a-9eb5-af5e79e42669

	measure 'Review Growth Same Period' = DIVIDE([Reviews Same Period 2026]-[Reviews Same Period 2025],[Reviews Same Period 2025])
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 968d3d54-e38e-49ab-8794-083ab6de9b6b

	measure 'Median Price Entire Home' = CALCULATE([Median Price],dim_listing[room_type] = "Entire home/apt" )
		formatString: #,0
		lineageTag: 7c063216-a9ce-4254-a56c-a8f22ef58c85

	measure 'Unavailable-day Rate' = ```
			
			VAR unavailable =
			    CALCULATE (
			        SUM ( fact_calendar_monthly[unavailable_days]),
			        dim_listing[is_price_outlier] = FALSE(),
			        NOT ISBLANK(dim_listing[price])
			    )
			VAR days =
			    CALCULATE (
			        SUM ( fact_calendar_monthly[days_in_data]), dim_listing[is_price_outlier] = FALSE(),
			        NOT ISBLANK(dim_listing[price])
			    )
			RETURN DIVIDE (unavailable,days)       
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 2cacba57-fce5-4e2d-ab3b-70325559ac68

	measure 'Missing License Share 100+ Nights' = ```
			
			VAR longStayMissing =
			    CALCULATE([Total Listings], dim_listing[is_long_min_stay] = TRUE(), dim_listing[license_status] = "Missing" ) 
			VAR longStayListings =
			    CALCULATE( [Total Listings], dim_listing[is_long_min_stay] = TRUE() )
			RETURN DIVIDE ( longStayMissing, longStayListings)    
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 54027700-bab6-4346-b351-bc3375f6c4b3

	measure 'Largest Host Listings' = MAX ( dim_host[listings_in_data])
		formatString: 0
		lineageTag: 59614033-3901-4d9e-b658-f11fd2801ab2

	measure 'TOP 10% Hosts Share' =
			
			VAR cutoff = ROUND (COUNTROWS( dim_host) * 0.1,0)
			VAR topListings = CALCULATE(SUM ( dim_host[listings_in_data] ),dim_host[host_rank]<=cutoff)
			VAR allListings = SUM(dim_host[listings_in_data])
			RETURN
			    DIVIDE (topListings,allListings)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: abcb1906-1803-41ae-a5c7-6395853e7c76

	measure 'Superhost Premium Entire Home' =
			
			VAR superhost = CALCULATE ( [Median Price Entire Home], dim_listing[is_superhost] = TRUE())
			VAR other = CALCULATE( [Median Price Entire Home],dim_listing[is_superhost] = FALSE())
			RETURN
			    DIVIDE ( superhost- other,other )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: e7ea292f-3ed5-4f67-81a7-c780c2d228dc

	measure 'Average Listing' = CALCULATE( AVERAGE( dim_listing[review_scores_rating]), dim_listing[is_long_min_stay] = FALSE())
		formatString: 0.00
		lineageTag: 2ce860ef-d78c-4c91-b69e-248bdf3c3ee4

	measure 'Reviews per Listing' = CALCULATE(AVERAGE(dim_listing[number_of_reviews_ltm]),dim_listing[is_long_min_stay]=FALSE())
		formatString: 0.0
		lineageTag: 31d9b127-e2c3-4e10-81ae-6e1ed06c9cfc

	measure 'Superhost Review Ratio' =
			
			DIVIDE(
			     CALCULATE( [Reviews per Listing],dim_listing[is_superhost]=TRUE()),
			     CALCULATE( [Reviews per Listing],dim_listing[is_superhost]=FALSE()))
		formatString: 0.0"x"
		lineageTag: 9bc3eb2c-425f-49b1-92cf-4d853690eb5d

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'New Host Rating' = CALCULATE( [Average Rating], dim_host[tenure_band_order]=1)
		formatString: 0.00
		lineageTag: 521babbd-d142-4ab1-b0d4-db9035ae27a5

	measure 'Average Rating' = CALCULATE ( AVERAGE ( dim_listing[review_scores_rating] ), dim_listing[is_long_min_stay] = FALSE () )
		lineageTag: 52eaa44b-2235-4b92-854b-3a68d86142ab

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Median Price per Person' = ```
			
			CALCULATE(
			        MEDIANX( dim_listing, DIVIDE(dim_listing[price],dim_listing[accommodates])),
			        dim_listing[room_type] = "Entire home/apt" ,
			        dim_listing[is_long_min_stay] = FALSE(),
			        dim_listing[is_price_outlier] = FALSE(),
			        NOT ISBLANK( dim_listing[price])
			)        
			
			```
		formatString: #,0
		lineageTag: 2a08b5e5-6205-487a-b621-bd143aa86940

	measure 'Pool Premium per Person' =
			
			VAR withPool = CALCULATE([Median Price per Person], dim_listing[has_pool] = TRUE())
			VAR withoutPool = CALCULATE([Median Price per Person], dim_listing[has_pool] = FALSE())
			RETURN
			    DIVIDE (withPool-withoutPool, withoutPool)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 72eaf095-97b9-4500-95f9-52860a66e708

	measure 'Balcony Premium per Person' =
			
			VAR withBalcony = CALCULATE ( [Median Price per Person], dim_listing[has_balcony] = TRUE () )
			VAR withoutBalcony = CALCULATE ( [Median Price per Person], dim_listing[has_balcony] = FALSE () )
			RETURN
			    DIVIDE ( withBalcony - withoutBalcony, withoutBalcony )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 69deba3a-0fb5-477a-8373-969b0b0fa9e2

	measure 'Sub-score Average' =
			
			VAR selectedScore = SELECTEDVALUE ( SubScores[sub_score] )
			RETURN
			    CALCULATE (
			        SWITCH (
			            selectedScore,
			            "Value", AVERAGE ( dim_listing[review_scores_value] ),
			            "Cleanliness", AVERAGE ( dim_listing[review_scores_cleanliness] ),
			            "Accuracy", AVERAGE ( dim_listing[review_scores_accuracy] ),
			            "Location", AVERAGE ( dim_listing[review_scores_location] ),
			            "Check-in", AVERAGE ( dim_listing[review_scores_checkin] ),
			            "Communication", AVERAGE ( dim_listing[review_scores_communication] )
			        ),
			        dim_listing[is_long_min_stay] = FALSE ()
			    )
		formatString: 0.00
		lineageTag: 654462d7-f468-49b9-8c50-65dac2db22c7

	measure 'Sub-score Gap' =
			
			VAR topRated = CALCULATE ( [Sub-score Average], dim_listing[review_scores_rating] >= 4.8 )
			VAR lowRated = CALCULATE ( [Sub-score Average], dim_listing[review_scores_rating] < 4.5 )
			RETURN
			    topRated - lowRated
		formatString: 0.00
		lineageTag: fe9e8f39-13ec-4e7b-94cd-7c43aab935b5

	measure 'Priced Short-Term Listings' =
			
			CALCULATE([Total Listings],
			    dim_listing[is_long_min_stay] = FALSE(),
			    dim_listing[is_price_outlier] = FALSE(),
			    NOT ISBLANK(dim_listing[price]))
		formatString: #,0
		lineageTag: 0c534187-61c8-4b42-ac0d-00e1cc8d0484

	measure 'Price per Person 2 Guests' =
			
			CALCULATE (
			    [Median Price per Person],
			    dim_listing[accommodates] = 2
			)
		formatString: #,0
		lineageTag: d9ad5a6c-2851-49d4-ae08-6b1b6f706b5e

	measure 'Price per Person 4 Guests' =
			
			CALCULATE (
			    [Median Price per Person],
			    dim_listing[accommodates] = 4
			)
		formatString: #,0
		lineageTag: 83e87c72-d9eb-4dc0-aadb-db92b44f92d0

	measure 'Price per Person Change 2 to 4 Guests' =
			
			VAR TwoGuests = [Price per Person 2 Guests]
			VAR FourGuests = [Price per Person 4 Guests]
			RETURN
			    DIVIDE ( FourGuests - TwoGuests, TwoGuests )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 74d09280-d5d8-4bea-955d-309b9eb3ee17

	measure 'Available-day Rate' =
			
			VAR available =
			    CALCULATE (
			        SUM ( fact_calendar_monthly[available_days] ),
			        dim_listing[is_price_outlier] = FALSE (),
			        NOT ISBLANK ( dim_listing[price] )
			    )
			VAR days =
			    CALCULATE (
			        SUM ( fact_calendar_monthly[days_in_data] ),
			        dim_listing[is_price_outlier] = FALSE (),
			        NOT ISBLANK ( dim_listing[price] )
			    )
			RETURN
			    DIVIDE ( available, days )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: ab8e6fe6-d2ef-463f-97c6-b8090645cb52

	measure 'Available Days Next Month' =
			
			CALCULATE (
			    [Available-day Rate],
			    dim_date[year_month] = "2026-10"
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 83276edb-0fc5-4418-8d97-4eceafc73432

	measure 'Review Share by Month' =
			
			VAR monthReviews =
			    CALCULATE (
			        [Reviews],
			        dim_date[year_num] >= 2023 && dim_date[year_num] <= 2025
			    )
			VAR allReviews =
			    CALCULATE (
			        [Reviews],
			        dim_date[year_num] >= 2023 && dim_date[year_num] <= 2025,
			        REMOVEFILTERS ( dim_date[month_name], dim_date[month_num] )
			    )
			RETURN
			    DIVIDE ( monthReviews, allReviews )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 3f4c0e78-0e9d-4577-9a91-c96675efe06c

	measure 'Busiest Month Share' =
			
			MAXX (
			    ALL ( dim_date[month_name], dim_date[month_num] ),
			    [Review Share by Month]
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 33f5e37d-3bb7-47e5-8a03-4ca1d2c3a47f

	measure 'Busiest Month' =
			
			VAR topMonth =
			    TOPN (
			        1,
			        ALL ( dim_date[month_name], dim_date[month_num] ),
			        [Review Share by Month]
			    )
			RETURN
			    MAXX ( topMonth, dim_date[month_name] )
		lineageTag: 3adfab48-1cf5-4f83-a55d-bc6f406596aa

	measure 'Median Price Istanbul' =
			
			CALCULATE( [Median Price], REMOVEFILTERS(dim_neighbourhood))
		formatString: #,0
		lineageTag: 37877aa0-7684-40e3-b17a-fc0b4b03e91c

	measure 'Unavailable-day Rate Istanbul' =
			
			CALCULATE([Unavailable-day Rate], REMOVEFILTERS(dim_neighbourhood))
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 5519ecf1-248c-4187-b0a0-3eafe42ce6c5

	measure 'Average Rating Istanbul' =
			
			CALCULATE([Average Rating], REMOVEFILTERS(dim_neighbourhood))
		formatString: 0.00
		lineageTag: 5d01e2d9-f18d-402c-bcae-c0cfa3f6ff61

	measure 'Reviews per Listing Istanbul' =
			
			CALCULATE( [Reviews per Listing], REMOVEFILTERS(dim_neighbourhood))
		formatString: 0.0
		lineageTag: c86de5eb-f2f2-4581-a4f8-785ec9b8e06d

	measure 'Review Share by Month Istanbul' =
			
			CALCULATE( [Review Share by Month], REMOVEFILTERS(dim_neighbourhood))
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 2b748e85-a667-4c4c-9eb2-c96dca26107c

	measure 'Neighbourhood Listing Share' =
			
			DIVIDE ( [Total Listings], CALCULATE([Total Listings],REMOVEFILTERS(dim_neighbourhood)))
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 0b6d2af4-e514-48cc-aa87-af283de7fa73

	measure 'Selected Neighbourhood Title' =
			
			"Selected neighbourhood: "
			    & SELECTEDVALUE ( dim_neighbourhood[neighbourhood], "All neighbourhoods" )
		lineageTag: 74262230-cf95-4284-9045-7197703cebfe

	measure 'Total Listings Istanbul' =
			
			CALCULATE([Total Listings],REMOVEFILTERS(dim_neighbourhood))
		formatString: #,0
		lineageTag: f4ba747a-234e-449d-9705-c2594fcd9092

	partition _Measures = m
		mode: import
		source =
				let
				    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"Column1", type text}}),
				    #"Removed Columns" = Table.RemoveColumns(#"Changed Type",{"Column1"})
				in
				    #"Removed Columns"

	annotation PBI_ResultType = Table

