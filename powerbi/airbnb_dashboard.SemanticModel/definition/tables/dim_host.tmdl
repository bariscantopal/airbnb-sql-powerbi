table dim_host
	lineageTag: 98928e6f-7839-42d9-96bc-4262d1143cfb

	column host_id
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: cf7bb974-744c-48d4-8105-b35fd8cf636f
		summarizeBy: none
		sourceColumn: host_id

		annotation SummarizationSetBy = Automatic

	column host_tenure_months
		dataType: int64
		formatString: 0
		lineageTag: 47b58f8d-1e5b-4de6-936a-59798b07f8f6
		summarizeBy: none
		sourceColumn: host_tenure_months

		annotation SummarizationSetBy = Automatic

	column listings_in_data
		dataType: int64
		formatString: 0
		lineageTag: 4dbdd77a-c1d1-4d50-8d2a-1a520be9d0e0
		summarizeBy: none
		sourceColumn: listings_in_data

		annotation SummarizationSetBy = Automatic

	column host_rank =
			
			VAR myListings = dim_host[listings_in_data]
			VAR myId = dim_host[host_id]
			RETURN
			    COUNTROWS (
			        FILTER (
			            dim_host,
			            dim_host[listings_in_data] > myListings
			                || ( dim_host[listings_in_data] = myListings && dim_host[host_id] < myId )
			        )
			    ) + 1
		formatString: 0
		lineageTag: 55bb55f0-d364-494d-883d-8f9c1fe3343d
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column cumulative_listing_share =
			
			VAR myRank = dim_host[host_rank]
			VAR runningTotal =
			    SUMX (
			        FILTER ( dim_host, dim_host[host_rank] <= myRank ),
			        dim_host[listings_in_data]
			    )
			VAR total = SUM ( dim_host[listings_in_data] )
			RETURN
			    DIVIDE ( runningTotal, total )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 700dedc6-ab4c-4cc4-9fe7-c754eadb244f
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column host_rank_pct = DIVIDE(dim_host[host_rank],COUNTROWS(dim_host))
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 56c3ef9a-5fac-4a63-8def-8521c06d5d3d
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column tenure_band_order = ```
			
			SWITCH(
			    TRUE(),
			    dim_host[host_tenure_months] <= 21, 1,
			    dim_host[host_tenure_months] <= 46, 2,
			    dim_host[host_tenure_months] <= 82, 3,
			    4
			)    
			```
		isHidden
		formatString: 0
		lineageTag: a3e396c6-9e06-4d6d-a7db-d4c89c60beac
		summarizeBy: none

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column tenure_band = ```
			
			SWITCH(
			    dim_host[tenure_band_order],
			    1, "0-21 months",
			    2, "22-46 months" ,
			    3, "47-82 months" ,
			    4, "83+ months"
			)    
			```
		lineageTag: 3594d790-73bb-49c9-a699-11d8debf6441
		summarizeBy: none

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	partition dim_host = m
		mode: import
		source =
				let
				    Source = Sql.Database(".\SQLEXPRESS", "AirbnbDWH"),
				    gold_dim_host = Source{[Schema="gold",Item="dim_host"]}[Data],
				    #"Removed Columns" = Table.RemoveColumns(gold_dim_host,{"is_superhost", "host_segment", "host_identity_verified", "host_tenure_years"})
				in
				    #"Removed Columns"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

